; Minimal topology for testing the extracted single CLS chain with grompp.

[ defaults ]
; nbfunc        comb-rule       gen-pairs       fudgeLJ fudgeQQ
1               2               yes             0.5     0.8333333333

[ atomtypes ]
; name  bond_type     mass     charge   ptype   sigma         epsilon
hc      hc            0.00000  0.00000   A      2.60018e-01   8.70272e-02
c3      c3            0.00000  0.00000   A      3.39771e-01   4.51035e-01
h2      h2            0.00000  0.00000   A      2.24382e-01   8.70272e-02
h1      h1            0.00000  0.00000   A      2.42200e-01   8.70272e-02
oh      oh            0.00000  0.00000   A      3.24287e-01   3.89112e-01
ho      ho            0.00000  0.00000   A      5.37925e-02   1.96648e-02
os      os            0.00000  0.00000   A      3.15610e-01   3.03758e-01

#include "CLS_single_corrected.itp"

[ system ]
CLS single chain

[ molecules ]
; Compound        #mols
CLS               1
