; Energy Minimization
; ===================
integrator               = steep
nsteps                  = 5000
emtol                   = 1000.0
emstep                  = 0.01

; Output
nstlog                  = 500
nstenergy              = 500

; Interruption handling
; controller              = horizon
continuation           = no

; Bond constraints
constraint_algorithm    = lincs
constraints            = h-bonds
lincs_iter             = 1
lincs_order            = 4

; Electrostatics
cutoff-scheme          = Verlet
coulombtype           = PME
rcoulomb              = 1.2
rvdw                  = 1.2

; Temperature
tcoupl                = no

; Pressure
pcoupl                = no
